{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emab:schema:receipt:0.1.0",
  "title": "Immutable Execution Receipt",
  "type": "object",
  "required": ["protocol_version", "algorithm", "created_at", "files", "bundle_digest"],
  "properties": {
    "protocol_version": {"const": "0.1.0"},
    "algorithm": {"const": "sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "bundle_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}

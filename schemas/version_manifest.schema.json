{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emab:schema:version-manifest:0.1.0",
  "title": "Participant System Version Manifest",
  "type": "object",
  "required": ["protocol_version", "participant_id", "system_id", "version_id", "parent_version_id", "models", "system_boundary", "configuration_digest", "change_declaration", "created_at"],
  "properties": {
    "protocol_version": {"const": "0.1.0"},
    "participant_id": {"type": "string", "minLength": 1},
    "system_id": {"type": "string", "minLength": 1},
    "version_id": {"type": "string", "minLength": 1},
    "parent_version_id": {"type": ["string", "null"]},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider", "model", "version"],
        "properties": {
          "provider": {"type": "string"},
          "model": {"type": "string"},
          "version": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "system_boundary": {"type": "string", "minLength": 1},
    "tool_privileges": {"type": "array", "items": {"type": "string"}},
    "persistent_memory": {"type": "boolean"},
    "configuration_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "change_declaration": {
      "type": "object",
      "required": ["evidence_used", "components_changed", "intended_failure_classes", "regression_scope"],
      "properties": {
        "evidence_used": {"type": "array", "items": {"type": "string"}},
        "components_changed": {"type": "array", "items": {"type": "string"}},
        "intended_failure_classes": {"type": "array", "items": {"type": "string"}},
        "regression_scope": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
